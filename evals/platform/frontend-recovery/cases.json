{
  "schema_version": 1,
  "suite": "frontend-recovery",
  "version": "frontend-recovery-v3",
  "synthetic": true,
  "cases": [
    {
      "id": "old-remediation-cache-reopens-v1",
      "kind": "recovery",
      "recovery": {
        "action": "repair-old-remediation"
      },
      "expected": {
        "equals": {
          "status": "ready",
          "question_restored": true,
          "correct": 0,
          "original_unchanged": true
        }
      }
    },
    {
      "id": "unfinished-stage-before-finish-v1",
      "kind": "recovery",
      "recovery": {
        "action": "unfinished-before-completion"
      },
      "expected": {
        "equals": {
          "action": "complete",
          "target": "fractions"
        }
      }
    },
    {
      "id": "resumed-answer-not-counted-twice-v1",
      "kind": "recovery",
      "recovery": {
        "action": "resume-correct"
      },
      "expected": {
        "equals": {
          "correct": 1,
          "next_question": "synthetic-next-question",
          "stage_complete": false
        }
      }
    },
    {
      "id": "source-question-id-resume-v1",
      "kind": "recovery",
      "recovery": {
        "action": "resume-source-ids"
      },
      "expected": {
        "equals": {
          "queue": [
            "f1"
          ],
          "pool": []
        }
      }
    },
    {
      "id": "server-historical-state-unchanged-v1",
      "kind": "recovery",
      "recovery": {
        "action": "historical-complete"
      },
      "expected": {
        "equals": {
          "statuses": [
            "complete",
            "complete",
            "complete"
          ],
          "counts": [
            0,
            0,
            0
          ]
        }
      }
    },
    {
      "id": "nullable-checkpoint-hydrates-v1",
      "kind": "recovery",
      "recovery": {
        "action": "nullable-checkpoint"
      },
      "expected": {
        "equals": {
          "phase": "question",
          "lines": [],
          "step_index": 0,
          "tutor_message": "",
          "wrong": null,
          "decision": null
        }
      }
    },
    {
      "id": "published-checkpoint-id-and-null-fields-v1",
      "kind": "recovery",
      "recovery": {
        "action": "source-checkpoint"
      },
      "expected": {
        "equals": {
          "question_id": "f1",
          "lines": [],
          "step_index": 0,
          "tutor_message": ""
        }
      }
    },
    {
      "id": "wrong-helpful-review-and-continue-v2",
      "kind": "recovery",
      "recovery": {
        "action": "wrong-feedback-continue",
        "feedback": "helpful"
      },
      "expected": {
        "equals": {
          "same_question": false,
          "pod": "simple-equations",
          "phase": "question",
          "correct": 0,
          "stage_complete": true,
          "queue_size": 0,
          "feedback_support": true,
          "decision": "complete",
          "clean_next": true
        }
      }
    },
    {
      "id": "wrong-confusing-review-and-continue-v2",
      "kind": "recovery",
      "recovery": {
        "action": "wrong-feedback-continue",
        "feedback": "confusing"
      },
      "expected": {
        "equals": {
          "same_question": false,
          "pod": "simple-equations",
          "phase": "question",
          "correct": 0,
          "stage_complete": true,
          "queue_size": 0,
          "feedback_support": true,
          "decision": "complete",
          "clean_next": true
        }
      }
    },
    {
      "id": "wrong-too-easy-review-and-continue-v2",
      "kind": "recovery",
      "recovery": {
        "action": "wrong-feedback-continue",
        "feedback": "too-easy"
      },
      "expected": {
        "equals": {
          "same_question": false,
          "pod": "simple-equations",
          "phase": "question",
          "correct": 0,
          "stage_complete": true,
          "queue_size": 0,
          "feedback_support": true,
          "decision": "complete",
          "clean_next": true
        }
      }
    },
    {
      "id": "wrong-too-hard-review-and-continue-v2",
      "kind": "recovery",
      "recovery": {
        "action": "wrong-feedback-continue",
        "feedback": "too-hard"
      },
      "expected": {
        "equals": {
          "same_question": false,
          "pod": "simple-equations",
          "phase": "question",
          "correct": 0,
          "stage_complete": true,
          "queue_size": 0,
          "feedback_support": true,
          "decision": "complete",
          "clean_next": true
        }
      }
    },
    {
      "id": "wrong-then-next-correct-advances-v2",
      "kind": "recovery",
      "recovery": {
        "action": "wrong-then-next-correct"
      },
      "expected": {
        "equals": {
          "retried_question": false,
          "correct": 0,
          "stage_complete": true,
          "next_pod": "two-step-equations",
          "incorrect_kept": true
        }
      }
    },
    {
      "id": "reviewed-pool-does-not-repeat-current-v2",
      "kind": "recovery",
      "recovery": {
        "action": "duplicate-reviewed-pool"
      },
      "expected": {
        "equals": {
          "same_question": false,
          "queue_size": 0,
          "correct": 0,
          "stage_complete": true
        }
      }
    }
  ]
}
