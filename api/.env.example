HOST=0.0.0.0
PORT=4004
APP_ENV=development
# Exact comma-separated browser origins; required HTTPS allowlist in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

FIREBASE_PROJECT_ID=allthingsagentichackatho-ee359
FIREBASE_CREDENTIALS_FILE=secrets/firebase/classgame-firebase-adminsdk.json
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PING_TIMEOUT_SECONDS=5
FIREBASE_STORAGE_BUCKET=allthingsagentichackatho-ee359.firebasestorage.app
FIREBASE_BOOTSTRAP_ENABLED=true
FIREBASE_BOOTSTRAP_TIMEOUT_SECONDS=30

# Configure the shared teacher locally. The password has no source-code default
# and is never returned by the API.
DEMO_TEACHER_EMAIL=
DEMO_TEACHER_PASSWORD=
DEMO_TEACHER_DISPLAY_NAME=

DEFAULT_ORGANIZATION_ID=default-org
DEFAULT_ORGANIZATION_NAME=ClassGame
DEFAULT_DISTRICT_ID=default-district
DEFAULT_DISTRICT_NAME=ClassGame District
DEFAULT_SCHOOL_ID=default-school
DEFAULT_SCHOOL_NAME=ClassGame School

# API stays interactive. Run a separate worker with APP_ROLE=worker, or both with all.
APP_ROLE=api
TASKS_ENABLED=false
# Required when enabled; a dedicated durable broker, never a cache fallback.
TASKS_REDIS_URL=
TASKS_QUEUE=classgame-background
TASKS_CONCURRENCY=4
STUDENT_ABANDONMENT_SECONDS=120

AUTH_TEACHER_PROVIDERS=google,password
AUTH_STUDENT_PROVIDERS=anonymous

GENAI_ENABLED=true
GENAI_BACKEND=vertex
GENAI_MODEL=gemini-3.7-flash
GENAI_PROJECT_ID=rare-tape-466414-f4
GENAI_LOCATION=global
GENAI_API_KEY=
GENAI_CREDENTIALS_FILE=
GENAI_CREDENTIALS_JSON=
GENAI_REQUEST_TIMEOUT_SECONDS=30
GENAI_MAX_OUTPUT_TOKENS=4096

# Server-side product events and automatic panic/HTTP 5xx error tracking.
# Keep disabled locally unless you intentionally want to send development data.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_TOKEN=phc_rSqPFFgY7jqf7XxP7QAXXUhZ76Wt9HtJGKZx4A2EXfz4
POSTHOG_HOST=https://us.i.posthog.com

REDIS_URL=redis://default:<password>@<host>:<port>
REDIS_PING_TIMEOUT_SECONDS=5
